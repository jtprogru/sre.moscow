---
import { SITE } from '../lib/site';

interface Props {
  /** Заголовок страницы без названия сайта. На главной не передаётся. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Узлы schema.org этой страницы; попадают в общий @graph рядом с WebSite. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.description, noindex = false, jsonLd = [] } = Astro.props;

// Формула <title>: у главной «название — дескриптор», у остальных название
// сайта стоит хвостом. Её же сверяет tools/check-copy.mjs по dist/.
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.descriptor}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og.png', Astro.site).toString();

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'ru-RU',
    },
    ...jsonLd,
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.descriptor}. ${SITE.slogan}`} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
